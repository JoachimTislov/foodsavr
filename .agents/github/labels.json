{
  "schema_version": 2,
  "managed_prefixes": ["type/", "area/", "status/", "risk/"],
  "legacy_label_map": {
    "bug": "type/bug", "feature": "type/feature", "enhancement": "type/feature",
    "task": "type/task", "chore": "type/task", "documentation": "type/documentation",
    "android": "area/android", "ui": "area/ui", "web": "area/web", "ci": "area/ci",
    "testing": null, "alpha": null, "future": null, "architecture": null, "auth": null, "performance": null,
    "automation/agent-managed": null
  },
  "labels": [
    {"name": "type/bug", "color": "d73a4a", "description": "A reproducible defect"},
    {"name": "type/feature", "color": "a2eeef", "description": "A user-facing capability"},
    {"name": "type/task", "color": "006b75", "description": "A bounded engineering task"},
    {"name": "type/documentation", "color": "0075ca", "description": "Documentation or agent-context work"},
    {"name": "type/dependency", "color": "0366d6", "description": "Dependency or toolchain maintenance"},
    {"name": "area/app", "color": "450d51", "description": "Application behavior"},
    {"name": "area/ui", "color": "fbca04", "description": "User interface"},
    {"name": "area/android", "color": "006b75", "description": "Android platform"},
    {"name": "area/web", "color": "450d51", "description": "Web platform"},
    {"name": "area/firestore", "color": "42ddf6", "description": "Firestore or security rules"},
    {"name": "area/ci", "color": "360dd1", "description": "CI, automation, or GitHub configuration"},
    {"name": "area/agents", "color": "8d80e9", "description": "Agent orchestration and provider setup"},
    {"name": "status/ci-pending", "color": "fbca04", "description": "Required checks are pending"},
    {"name": "status/ci-failing", "color": "d73a4a", "description": "A check failed"},
    {"name": "risk/security", "color": "b60205", "description": "Security-sensitive change"}
  ],
  "area_priority": ["area/agents", "area/ci", "area/firestore", "area/android", "area/web", "area/ui", "area/app"],
  "title_body_rules": [
    {"label": "type/bug", "patterns": ["^\\s*(fix|bug)(\\(|:|\\s)", "\\bregression\\b"]},
    {"label": "type/feature", "patterns": ["^\\s*(feat|feature)(\\(|:|\\s)"]},
    {"label": "type/documentation", "patterns": ["^\\s*(docs?|documentation)(\\(|:|\\s)"]},
    {"label": "type/dependency", "patterns": ["^\\s*(build|deps?|dependency)(\\(|:|\\s)", "\\bdependabot\\b", "\\bbump\\b"]},
    {"label": "type/task", "patterns": ["^\\s*(chore|task|refactor|ci)(\\(|:|\\s)"]}
  ],
  "path_rules": [
    {"label": "area/agents", "patterns": [".agents/", "AGENTS.md", "CLAUDE.md", "GEMINI.md", "scripts/agents/"]},
    {"label": "area/ci", "patterns": [".github/", "Makefile", "scripts/ci/"]},
    {"label": "area/firestore", "patterns": ["firestore.rules", "firestore-rules/", "firebase.json"]},
    {"label": "area/android", "patterns": ["android/", "build-android"]},
    {"label": "area/web", "patterns": ["web/", "build-web"]},
    {"label": "area/ui", "patterns": ["/view", "_view.dart", "widgets/", "screens/"]},
    {"label": "area/app", "patterns": ["lib/"]}
  ],
  "risk_rules": [
    {"label": "risk/security", "patterns": ["firestore.rules", "firestore-rules/", ".github/workflows/", ".agents/policies/", ".agents/runners/"]}
  ]
}
