{
  "apiVersion": "agents.foodsavr.dev/v1alpha1",
  "kind": "AgentSystem",
  "metadata": {
    "name": "foodsavr",
    "defaultBranch": "develop"
  },
  "spec": {
    "controlPlane": {
      "minPolicySafeProviders": 1,
      "requiredHooksPath": ".githooks",
      "skillsSync": true,
      "logsFormat": "jsonl"
    },
    "ciRunners": {
      "providerAuthSecretsAnyOf": [
        "CLAUDE_CODE_OAUTH_TOKEN",
        "CODEX_AUTH_JSON_B64",
        "ANTIGRAVITY_OAUTH_TOKEN_B64",
        "GEMINI_API_KEY"
      ],
      "agentAppSecretsAllOf": [
        "AGENT_APP_ID",
        "AGENT_APP_PRIVATE_KEY"
      ],
      "mergeGateWorkflow": "merge-gate.yml",
      "releaseGateAppSecretsAllOf": [
        "RELEASE_GATE_APP_ID",
        "RELEASE_GATE_APP_PRIVATE_KEY"
      ]
    },
    "router": {
      "mode": "local-deterministic"
    },
    "governance": {
      "disallowDuplicateRequiredChecks": true,
      "traceabilityWorkflow": "traceability.yml"
    },
    "observability": {
      "autoHealVar": "AUTO_HEAL_ENABLED",
      "telemetryPollVar": "TELEMETRY_POLL_ENABLED",
      "wifVarsAllOf": [
        "GCP_WORKLOAD_IDENTITY_PROVIDER",
        "GCP_DEPLOY_SERVICE_ACCOUNT"
      ],
      "webMonitorWorkflow": "web-monitor.yml",
      "transcriptArchive": {
        "configFile": ".agents/sessions/archive.json",
        "verifyBucket": true
      }
    },
    "delivery": {
      "promoteWorkflow": "promote.yml",
      "detectOrphanedWorkflows": true
    }
  }
}
