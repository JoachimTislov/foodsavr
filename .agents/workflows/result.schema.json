{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent workflow result",
  "$defs": {
    "failure_kind": {"type": "string"},
    "resets_at": {"type": "string", "format": "date-time"}
  },
  "type": "object",
  "required": ["workflow_id", "run_id", "status", "started_at", "steps", "session_ids", "artifacts", "events", "usage", "ledger_refs"],
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["planned", "succeeded", "failed", "cancelled", "unavailable", "awaiting_acceptance"]}}},
      "then": {"required": ["completed_at"], "properties": {"completed_at": {"minLength": 1}}}
    }
  ],
  "properties": {
    "workflow_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"enum": ["planned", "running", "succeeded", "failed", "cancelled", "unavailable", "awaiting_acceptance"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "failure_kind": {"$ref": "#/$defs/failure_kind"},
    "resets_at": {"$ref": "#/$defs/resets_at"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "acceptance_results"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["planned", "running", "succeeded", "failed", "cancelled", "unavailable", "awaiting_acceptance"]},
          "failure_kind": {"$ref": "#/$defs/failure_kind"},
          "resets_at": {"$ref": "#/$defs/resets_at"},
          "acceptance_results": {"type": "array", "items": {"type": "object"}},
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "failure_kind": {"$ref": "#/$defs/failure_kind"},
                "resets_at": {"$ref": "#/$defs/resets_at"}
              }
            }
          },
          "session_id": {"type": ["string", "null"]},
          "artifact": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "session_ids": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "events": {"type": "string"},
    "references": {
      "type": "object",
      "properties": {
        "issues": {"type": "array", "items": {"type": "string"}},
        "prs": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}},
        "commits": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "total_tokens": {"type": "number", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ledger_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
