<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <!-- https://stackoverflow.com/questions/73782320/onbackinvokedcallback-is-not-enabled-for-the-application-in-set-androidenableo#comment140574330_79605146 -->
    <application android:enableOnBackInvokedCallback="true" android:networkSecurityConfig="@xml/network_security_config"></application>
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
