#!/bin/sh
# Block pushes of branches behind the base branch, then run fast change-scoped checks (ADR 0006). Install: make hooks
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/ci/check_pr_base.py" || exit 1
exec python3 "$root/scripts/ci/local_ci.py" --pre-push
