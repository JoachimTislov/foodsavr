#!/bin/sh
# Appends "Agent-Session: <harness>:<id>" when an agent session is detected.
# Never blocks a commit (humans without a session are untouched).
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
"$root/scripts/agents/agentctl" hook prepare-commit-msg "$@" >/dev/null 2>&1 || true
exit 0
