# WEB_ENV_B64 is the Base64 form of assets/.env. Firebase Hosting serves the
# decoded file publicly. Use only approved public client configuration.
# OAuth tokens, client secrets and other credentials belong outside this file.
#
# Entries below are commented placeholders for client configuration. Supply
# only the keys needed for the configured provider. Leave an unused
# *_IS_SUPPORTED key absent. Its presence in production enables the provider
# in the connections list on platforms with a WebView.
#
# REMA_API_SUB_KEY is pending owner classification (#358).
# Keep it out of new web bundles until the owner confirms it may ship publicly.

# REMA
# REMA_IS_SUPPORTED=<Presence flag for the provider in production builds>
# REMA_API_URL=<Store API base URL used by the client>
# REMA_TRANSACTIONS=<Transaction endpoint path used by the REMA client>
# REMA_CLIENT_ID=<OAuth client ID for the public client>
# REMA_REDIRECT_URL=<Registered OAuth redirect URI>
# REMA_SCOPES=<OAuth scopes requested by the client>
# REMA_AUTHORIZATION_URL=<OAuth authorization endpoint URL>
# REMA_TOKEN_URL=<OAuth token exchange and refresh endpoint URL>
# REMA_AUDIENCE=<Optional OAuth audience parameter>

# Coop (API client is stubbed)
# COOP_IS_SUPPORTED=<Presence flag for the provider in production builds>
# COOP_API_URL=<Store API base URL used by the client>
# COOP_CLIENT_ID=<OAuth client ID for the public client>
# COOP_REDIRECT_URL=<Registered OAuth redirect URI>
# COOP_SCOPES=<OAuth scopes requested by the client>
# COOP_AUTHORIZATION_URL=<OAuth authorization endpoint URL>
# COOP_TOKEN_URL=<OAuth token exchange and refresh endpoint URL>
# COOP_AUDIENCE=<Optional OAuth audience parameter>

# Trumf (OAuth configuration)
# TRUMF_IS_SUPPORTED=<Presence flag for the provider in production builds>
# TRUMF_CLIENT_ID=<OAuth client ID for the public client>
# TRUMF_REDIRECT_URL=<Registered OAuth redirect URI>
# TRUMF_SCOPES=<OAuth scopes requested by the client>
# TRUMF_AUTHORIZATION_URL=<OAuth authorization endpoint URL>
# TRUMF_TOKEN_URL=<OAuth token exchange and refresh endpoint URL>
# TRUMF_AUDIENCE=<Optional OAuth audience parameter>
